# PaperMind Environment Configuration Template
PROJECT_NAME="PaperMind"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Security & JWT
SECRET_KEY="generate-a-secure-random-secret-key-with-minimum-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production / Docker)
POSTGRES_USER="papermind"
POSTGRES_PASSWORD="change_this_secure_password"
POSTGRES_DB="papermind_db"
DATABASE_URL="postgresql+asyncpg://papermind:change_this_secure_password@localhost:5432/papermind_db"
SYNC_DATABASE_URL="postgresql+psycopg2://papermind:change_this_secure_password@localhost:5432/papermind_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI Provider Selection ('heuristic', 'gemini', or 'openai')
AI_PROVIDER="heuristic"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Confidence Thresholds
CONFIDENCE_VERIFIED_MIN=0.90
CONFIDENCE_PARTIAL_MIN=0.70

# Storage
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_BYTES=26214400

# Frontend URL
NEXT_PUBLIC_API_URL="http://localhost:8000"

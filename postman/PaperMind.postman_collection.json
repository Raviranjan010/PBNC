          }
        },
        {
          "name": "Patch Question (Human Review & Approval)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_text\": \"Updated and verified question prompt?\",\n  \"answer\": \"A\",\n  \"status\": \"VERIFIED\",\n  \"review_required\": false,\n  \"is_reviewed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", "{{questionId}}"]
            }
          }
        }
      ]
    },
